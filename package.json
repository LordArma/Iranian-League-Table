{
  "name": "iranian-league-table",
  "private": true,
  "description": "Build tooling for the Iranian League Table block.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=src --output-path=wp-content/plugins/iranian-league-table/build",
    "start": "wp-scripts start --webpack-src-dir=src --output-path=wp-content/plugins/iranian-league-table/build",
    "lint:js": "wp-scripts lint-js src wp-content/plugins/iranian-league-table/assets/js",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "test:integration": "wp-env run tests-cli --env-cwd=ilt-repo vendor/bin/phpunit -c phpunit-integration.xml.dist",
    "test:integration:multisite": "wp-env run tests-cli --env-cwd=ilt-repo env WP_MULTISITE=1 vendor/bin/phpunit -c phpunit-integration.xml.dist"
  },
  "devDependencies": {
    "@wordpress/env": "^11.17.0",
    "@wordpress/scripts": "^36.1.0",
    "js-yaml": "file:tools/js-yaml-compat",
    "js-yaml-v4": "npm:js-yaml@^4.3.2",
    "simple-git": "file:tools/simple-git-cjs",
    "simple-git-v4": "npm:simple-git@^4.0.2"
  },
  "overrides": {
    "simple-git": "$simple-git",
    "@simple-git/argv-parser": "^2.0.1",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1",
    "postcss-selector-parser": "^7.1.6",
    "qs": "^6.16.0",
    "katex": "^0.18.2",
    "smol-toml": "^1.9.0",
    "@wordpress/env": {
      "js-yaml": "$js-yaml"
    },
    "markdownlint-cli": {
      "js-yaml": "^5.4.3"
    }
  }
}
